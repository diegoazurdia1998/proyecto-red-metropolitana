      <column aggregation='Avg' caption='Latitud_Calculada' datatype='real' name='[Calculation_0110279083442177]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='IF [zona_normalizada] = &quot;Zona 1&quot; THEN 14.6349&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 4&quot; THEN 14.6245&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 6&quot; THEN 14.6420&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 7&quot; THEN 14.6220&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 8&quot; THEN 14.6210&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 9&quot; THEN 14.6130&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 10&quot; THEN 14.5980&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 11&quot; THEN 14.6100&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 12&quot; THEN 14.5850&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 13&quot; THEN 14.5830&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 17&quot; THEN 14.6890&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 18&quot; THEN 14.7000&#13;&#10;ELSEIF [zona_normalizada] = &quot;Mixco&quot; THEN 14.6333&#13;&#10;ELSEIF [zona_normalizada] = &quot;San Miguel Petapa&quot; THEN 14.5025&#13;&#10;ELSEIF [zona_normalizada] = &quot;Villa Nueva&quot; THEN 14.5269&#13;&#10;END' />
      </column>
      <column aggregation='Avg' caption='Longitud_Calculada' datatype='real' name='[Calculation_0110279083630594]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative'>
        <calculation class='tableau' formula='IF [zona_normalizada] = &quot;Zona 1&quot; THEN -90.5069&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 4&quot; THEN -90.5180&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 6&quot; THEN -90.4970&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 7&quot; THEN -90.5500&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 8&quot; THEN -90.5320&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 9&quot; THEN -90.5250&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 10&quot; THEN -90.5150&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 11&quot; THEN -90.5400&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 12&quot; THEN -90.5500&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 13&quot; THEN -90.5200&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 17&quot; THEN -90.4950&#13;&#10;ELSEIF [zona_normalizada] = &quot;Zona 18&quot; THEN -90.4800&#13;&#10;ELSEIF [zona_normalizada] = &quot;Mixco&quot; THEN -90.6064&#13;&#10;ELSEIF [zona_normalizada] = &quot;San Miguel Petapa&quot; THEN -90.5511&#13;&#10;ELSEIF [zona_normalizada] = &quot;Villa Nueva&quot; THEN -90.5870&#13;&#10;END' />
