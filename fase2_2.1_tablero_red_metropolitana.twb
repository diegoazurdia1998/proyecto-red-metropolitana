      <column caption='Segmento Multimodal' datatype='string' name='[Calculation_2211168922845193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2211168922775560] = 1 THEN &quot;1 Modo (Unimodal)&quot;&#13;&#10;ELSEIF [Calculation_2211168922775560] = 2 THEN &quot;2 Modos (Bimodal)&quot;&#13;&#10;ELSEIF [Calculation_2211168922775560] = 3 THEN &quot;3 Modos (Trimodal)&quot;&#13;&#10;ELSE &quot;4 Modos (Integrado Total)&quot;&#13;&#10;END' />
      </column>
      <column caption='Combinacion de Modos' datatype='string' name='[Calculation_2211168929431563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [sk_usuario] : &#13;&#10;    TRIM(&#13;&#10;        IF MAX([sistema_modo] = &quot;Transmetro&quot;) THEN &quot;Transmetro &quot; ELSE &quot;&quot; END +&#13;&#10;        IF MAX([sistema_modo] = &quot;Transurbano&quot;) THEN &quot;Transurbano &quot; ELSE &quot;&quot; END +&#13;&#10;        IF MAX([sistema_modo] = &quot;MetroRiel&quot;) THEN &quot;MetroRiel &quot; ELSE &quot;&quot; END +&#13;&#10;        IF MAX([sistema_modo] = &quot;Aerometro&quot;) THEN &quot;Aerometro &quot; ELSE &quot;&quot; END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Es Corredor MetroRiel' datatype='string' name='[Calculation_2211168932950028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [zona_normalizada] IN (&quot;Zona 1&quot;, &quot;Zona 6&quot;, &quot;Zona 8&quot;, &quot;Zona 12&quot;, &quot;Zona 17&quot;) &#13;&#10;   OR [zona_normalizada] IN (&quot;Z1&quot;, &quot;Z6&quot;, &quot;Z8&quot;, &quot;Z12&quot;, &quot;Z17&quot;) THEN &#13;&#10;    &quot;Corredor MetroRiel (Zonas 1, 6, 8, 12, 17)&quot;&#13;&#10;ELSE &#13;&#10;    &quot;Otras Zonas Metropolitanas&quot;&#13;&#10;END' />
      </column>
